---
import menu from "../../data/menu.json";
import regions from "../../data/regions.json";
import Sidebar from "../components/Sidebar.astro";
import ContentPanel from "../components/ContentPanel.astro";
import "../styles/app.css";

type MenuItem = {
	name: string;
	file: string;
	image?: string;
	render_type?: string;
};

type RegionItem = {
	name: string;
	default?: boolean;
	image?: string;
};

const items = (menu.items ?? []) as MenuItem[];
const menuWidth = Math.max(1, Number(menu.width) || 1);
const regionItems = (regions.items ?? []) as RegionItem[];
const regionWidth = Math.max(1, Number(regions.width) || menuWidth);

const appData = {
	items,
	regions: regionItems,
};
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>RS3 Regions</title>
	</head>
	<body>
		<main class="page">
			<Sidebar items={items} menuWidth={menuWidth} regions={regionItems} regionWidth={regionWidth} />
			<ContentPanel />
		</main>
		<script id="app-data" type="application/json" set:html={JSON.stringify(appData)}></script>
		<script type="module" src="/scripts/app.js"></script>
	</body>
</html>
